# Copy to .env and adjust. Only variables prefixed VITE_APP_ reach the client,
# and every one of them is validated at startup in src/config/env.ts.

# Where the API lives. This used to be hardcoded in thirty-four source files.
VITE_APP_API_URL=http://localhost:5000

# Where this app is served from, used when building absolute links.
VITE_APP_APP_URL=http://localhost:5173
