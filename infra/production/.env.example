# Shah Kelid on a server. Copy to .env (./sk init does it, and fills in every
# secret it can make itself), then fill in the rest. Never commit .env.

# ----------------------------------------------------------------- addresses
# The main domain, without https:// ("shahkelid.com"). Email links, payment
# returns and customers' subscription links use it.
MAIN_DOMAIN=
# Every address the site answers on, comma separated: the main domain first,
# then www and any backup domains. Caddy takes a certificate for each.
SITE_ADDRESSES=
# Browsers may sign in and buy from every address above. This is only for an
# origin the site is not served on itself, as a full origin
# ("https://other.example"); usually empty.
ALLOWED_ORIGINS=
# Where Let's Encrypt writes about expiring certificates.
ACME_EMAIL=
# Behind Cloudflare: Cloudflare's address ranges (https://www.cloudflare.com/ips/),
# space separated, so the visitor's own address is seen. Without a CDN, leave
# it as it is: no one is trusted to say "the real address is…".
TRUSTED_PROXIES=127.0.0.1/32
# Only for trying it out without real domains (SITE_ADDRESSES=localhost):
# local_certs makes Caddy sign its own certificates. Leave empty on a server.
CADDY_LOCAL_CERTS=

# ------------------------------------------------- secrets (./sk init makes these)
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Signs the session cookie.
SESSION_SECRET=
# Encrypts two-step secrets and panel credentials in the database. Losing it
# means every authenticator and panel password must be set up again, so it
# is also written to the install report for you to keep somewhere safe.
APP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------- mail
# Required: sign-in codes go by email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ------------------------------------------------------------------ payments
ZARINPAL_SANDBOX=false
ZARINPAL_MERCHANT_ID=
# USDT on TRON: the receiving address only, never a key.
TRON_RECEIVE_ADDRESS=
TRONGRID_API_KEY=
# NOWPayments: leave empty to hide it at checkout.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# -------------------------------------------------------------------- alerts
# Owners and admins are emailed; with these, they also get Telegram messages.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=

# ------------------------------------------------------------------- backups
# An S3-compatible bucket, as restic writes it:
#   Backblaze B2:   s3:https://s3.us-west-004.backblazeb2.com/your-bucket
#   Cloudflare R2:  s3:https://<account-id>.r2.cloudflarestorage.com/your-bucket
# Or, until there is a bucket, a folder on this server: /backups/restic is
# BACKUP_LOCAL_DIR on the host. Such backups die with the server; copy them
# off it, or move to a bucket soon.
RESTIC_REPOSITORY=
BACKUP_LOCAL_DIR=/var/backups/shah-kelid
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
# Encrypts the backups. Without it they cannot be read, by anyone: keep a
# copy away from this server (./sk init prints it once).
RESTIC_PASSWORD=
# Every 6 hours at a quarter past, Tehran time.
BACKUP_SCHEDULE=15 */6 * * *
TZ=Asia/Tehran
# Optional: a monitor (healthchecks.io or the like) pinged after each backup,
# and at /fail when one fails. It notices when backups stop altogether.
BACKUP_PING_URL=

# ------------------------------------------------------------------- release
# The image tag ./sk update builds and runs.
RELEASE=latest
