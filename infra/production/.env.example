# Shah Kelid on a server. `shahkelid install` writes this file (as .env) and
# fills in everything below by itself; it is here to read, and to edit with
# `shahkelid edit-env`. Never commit .env.
#
# Mail, Telegram, the payment accounts (Zarinpal, USDT, NOWPayments) and
# backups are set in the staff area: /staff/settings. The values for them
# further down are only a fallback, for a section never saved there.

# ----------------------------------------------------------------- addresses
# The main domain, without https:// ("shahkelid.com"). Email links, payment
# returns and customers' subscription links use it.
MAIN_DOMAIN=
# Every address the site answers on, comma separated: the main domain first,
# then www and any backup domains. Caddy takes a certificate for each, and
# browsers may sign in and buy from each.
SITE_ADDRESSES=
# Any other origin browsers may use (a full origin, "https://other.example").
# Usually empty.
ALLOWED_ORIGINS=
# Optional: where Let's Encrypt may write about certificates.
ACME_EMAIL=
# Behind Cloudflare: Cloudflare's address ranges, space separated, so the
# visitor's own address is seen (the installer sets them when the domain is
# on Cloudflare). Otherwise as it is: nobody is trusted to say "the real
# address is…".
TRUSTED_PROXIES=127.0.0.1/32
# Only for trying it out without a real domain: Caddy signs its own
# certificates. Empty on a real server.
CADDY_LOCAL_CERTS=

# ------------------------------------------------------- secrets (made for you)
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Signs the session cookie.
SESSION_SECRET=
# Encrypts two-step secrets, panel credentials and the panel's settings in
# the database. Every backup carries it (encrypted), so a restore needs only
# RESTIC_PASSWORD.
APP_ENCRYPTION_KEY=
# The backup password: encrypts every backup, on this server, in S3 and on
# Telegram. Without it no backup can be read, by anyone: the installer shows
# it once, to keep away from this server.
RESTIC_PASSWORD=

# ------------------------------------------------------------------- backups
# Where the copy on this server lives (always kept, whatever else is set up).
BACKUP_LOCAL_DIR=/var/lib/shahkelid/backups
TZ=Asia/Tehran
# Optional: a monitor (healthchecks.io or the like) pinged after each backup,
# and at /fail when one fails. It notices when backups stop altogether.
BACKUP_PING_URL=

# --------------------------------------------- fallbacks (set in the panel)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
ZARINPAL_SANDBOX=false
ZARINPAL_MERCHANT_ID=
TRON_RECEIVE_ADDRESS=
TRONGRID_API_KEY=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
# Before M11 backups went to the S3 bucket set here; the panel's win.
RESTIC_REPOSITORY=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto

# ------------------------------------------------------------------- release
# The image tag that is built and run.
RELEASE=latest
