#!/usr/bin/env bash
# Everyday operations on the server, so no one has to remember compose flags.
# `shahkelid` (the command the installer puts in /usr/local/bin) runs these.
#
#   ./sk init                          make .env with fresh secrets (once)
#   ./sk up | down | restart           start (building what changed), stop, restart
#   ./sk status                        what is running, and is it healthy
#   ./sk logs [service]                follow the logs (app, worker, web, backup…)
#   ./sk owner create|password|reset-2fa <username>   the password comes on stdin
#   ./sk owner list                    every owner
#   ./sk create-owner <email>          an owner who signs in by email (or --another)
#   ./sk backup                        a backup now, to every destination set up
#   ./sk snapshots [s3]                the backups on this server (or in S3)
#   ./sk restore <id|latest> [--from s3] [--yes]
#   ./sk restore --file <backup.skb> [--yes]          a file from the Telegram bot
#   ./sk update                        pull the code, rebuild, restart
#   ./sk psql                          a database shell
#
# For a backup made on another server, give its backup password as
# RESTORE_PASSWORD (and, for its bucket, SK_S3_REPOSITORY and its keys).
set -euo pipefail
cd "$(dirname "$0")"

compose() { docker compose --env-file .env -f compose.yaml "$@"; }

need_env() {
  [ -f .env ] || { echo "No .env yet: run ./sk init first." >&2; exit 1; }
}

secret() { openssl rand -base64 "$1" | tr -d '\n/+=' | cut -c1-"$2"; }

env_value() { grep -E "^$1=" .env | head -n 1 | cut -d= -f2- | sed "s/^'//; s/'\$//"; }

# set_env KEY VALUE: one line of .env replaced in place; its mode stays 600.
set_env() {
  local line="$1=$2"
  [[ $2 =~ ^[A-Za-z0-9_./:@,+=%-]*$ ]] || line="$1='$2'"
  KEY=$1 LINE=$line awk '
    BEGIN { key = ENVIRON["KEY"] "="; line = ENVIRON["LINE"] }
    index($0, key) == 1 { print line; done = 1; next }
    { print }
    END { if (!done) print line }
  ' .env > .env.next
  cat .env.next > .env
  rm -f .env.next
}

# What restore.sh needs to reach a backup that is not this server's own.
restore_env=()
for name in RESTORE_PASSWORD SK_S3_REPOSITORY SK_S3_ACCESS_KEY_ID SK_S3_SECRET_ACCESS_KEY SK_S3_REGION; do
  [ -z "${!name:-}" ] || restore_env+=(-e "$name")
done

case "${1:-help}" in
  init)
    if [ -f .env ]; then echo ".env exists already; nothing changed." >&2; exit 1; fi
    cp .env.example .env
    chmod 600 .env
    sed -i \
      -e "s|^POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=$(secret 48 40)|" \
      -e "s|^REDIS_PASSWORD=.*|REDIS_PASSWORD=$(secret 48 40)|" \
      -e "s|^SESSION_SECRET=.*|SESSION_SECRET=$(secret 64 64)|" \
      -e "s|^APP_ENCRYPTION_KEY=.*|APP_ENCRYPTION_KEY=$(openssl rand -base64 32)|" \
      -e "s|^RESTIC_PASSWORD=.*|RESTIC_PASSWORD=$(secret 48 40)|" \
      .env
    echo "Made .env with fresh secrets. Fill in MAIN_DOMAIN and SITE_ADDRESSES; the rest is set in the panel."
    echo
    echo "Keep the backup password somewhere away from this server. Without it no backup can be read:"
    grep -E '^RESTIC_PASSWORD=' .env
    ;;
  up)
    need_env
    compose up -d --build --wait
    compose ps
    ;;
  down)
    need_env
    compose down
    ;;
  restart)
    need_env
    compose restart
    compose ps
    ;;
  status)
    need_env
    compose ps
    ;;
  logs)
    need_env
    shift
    compose logs -f --tail=200 "$@"
    ;;
  owner)
    need_env
    shift
    # The password, when there is one, comes on stdin: never in argv or history.
    compose run --rm -T --no-deps app npx tsx scripts/owner.ts "$@"
    ;;
  create-owner)
    need_env
    shift
    compose run --rm -T --no-deps app npx tsx scripts/create-owner.ts "$@" < /dev/null
    ;;
  backup)
    need_env
    compose exec -T backup backup.sh < /dev/null
    ;;
  snapshots)
    need_env
    compose exec -T "${restore_env[@]}" backup restore.sh --list "${2:-local}" < /dev/null
    ;;
  restore)
    need_env
    shift
    from=local file="" snapshot="" yes=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --from) from=$2; shift 2 ;;
        --file) file=$2; shift 2 ;;
        --yes) yes=1; shift ;;
        *) snapshot=$1; shift ;;
      esac
    done
    [ -n "$file$snapshot" ] || { echo "Which one? ./sk snapshots lists them; ./sk restore latest takes the newest." >&2; exit 2; }

    if [ -n "$file" ]; then
      [ -f "$file" ] || { echo "No such file: $file" >&2; exit 2; }
      compose cp "$file" backup:/var/lib/backup/incoming.skb
      what=(--file /var/lib/backup/incoming.skb)
      shown="the file $file"
    else
      # Show what there is to choose from: times, and the accounts-N tags.
      compose exec -T "${restore_env[@]}" backup restore.sh --list "$from" < /dev/null || true
      what=("$snapshot" --from "$from")
      shown="backup '$snapshot' ($from)"
    fi
    if [ "$yes" != 1 ]; then
      read -r -p "The database and files will be REPLACED by $shown. Type yes to go on: " answer
      [ "$answer" = "yes" ] || { echo "Nothing changed."; exit 1; }
    fi

    compose stop web app worker
    compose exec -T "${restore_env[@]}" backup restore.sh "${what[@]}" --yes < /dev/null

    # The key that came with the backup opens what its database keeps sealed.
    restored_key=$(compose exec -T backup sh -c 'cat /control/restored-keys.env 2>/dev/null' < /dev/null \
      | sed -n "s/^APP_ENCRYPTION_KEY='\(.*\)'\$/\1/p" | tr -d '\r')
    if [ -n "$restored_key" ] && [ "$restored_key" != "$(env_value APP_ENCRYPTION_KEY)" ]; then
      set_env APP_ENCRYPTION_KEY "$restored_key"
      echo "The backup's app key is now this server's (APP_ENCRYPTION_KEY in .env)."
    fi
    # In .env now; no copy is left lying about.
    compose exec -T backup rm -f /control/restored-keys.env < /dev/null || true
    # Restored from another server's backup: its password goes on, so backups
    # keep going to its bucket. This server's own copies so far were made
    # with the other password; they are kept aside, not deleted.
    if [ -n "${RESTORE_PASSWORD:-}" ] && [ "$RESTORE_PASSWORD" != "$(env_value RESTIC_PASSWORD)" ]; then
      set_env RESTIC_PASSWORD "$RESTORE_PASSWORD"
      local_dir=$(env_value BACKUP_LOCAL_DIR)
      local_dir=${local_dir:-/var/lib/shahkelid/backups}
      if [ -d "$local_dir/restic" ]; then
        mv "$local_dir/restic" "$local_dir/restic-before-restore-$(date +%Y%m%d-%H%M%S)"
      fi
      echo "The backup password is now the restored server's (RESTIC_PASSWORD in .env)."
    fi
    # Migrations first: a backup from an older release catches up here. The
    # app, the worker and the backup service pick up a changed .env.
    compose up -d --wait
    compose ps
    ;;
  update)
    need_env
    git pull --ff-only
    compose build
    # A rebuilt image does not always get its containers recreated (seen with
    # Compose 5 on Docker's containerd image store: the new web app was built
    # but the old one kept serving). So: the migrations first, then every
    # container built from this code is recreated outright.
    compose up -d --wait postgres redis
    compose run --rm migrate
    compose up -d --wait --no-deps --force-recreate app worker web backup
    docker image prune -f > /dev/null
    compose ps
    ;;
  psql)
    need_env
    compose exec postgres psql -U shah_kelid shah_kelid
    ;;
  *)
    sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
