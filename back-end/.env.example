# Copy to .env and fill in. Never commit the real .env.
# Everything here is read once, in src/config, and validated at boot: a missing
# required value in production stops the process instead of surfacing as
# `undefined` inside a request.

# ---------------------------------------------------------------- environment
NODE_ENV=development

# --------------------------------------------------------------------- server
HOST=localhost
PORT=5000
# Largest request body accepted.
BODY_LIMIT=100kb
# Where the browser app runs. CORS allows this origin and nothing else.
CLIENT_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------- database
DATABASE_HOST=127.0.0.1
DATABASE_NAME=shahkelid
# Set this instead of host/name to point at a replica set or Atlas.
# DATABASE_URI=mongodb://127.0.0.1:27017/shahkelid

# -------------------------------------------------------------------- session
# Required in production. Use a long random string, unique per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_NAME=shahkelid.sid
SESSION_MAX_AGE_MS=604800000

# --------------------------------------------------------------------- upload
UPLOAD_MAX_BYTES=5242880

# ----------------------------------------------------------------------- mail
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
# Required in production.
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@shahkelid.local

# -------------------------------------------------------------------- payment
# Required in production, where the app refuses to start without it.
# Left blank in development, the app uses a built-in stand-in gateway so the
# checkout flow can be walked end to end without real credentials.
ZARINPAL_MERCHANT_ID=
# "false" switches to the live gateway.
ZARINPAL_SANDBOX=true
PAYMENT_CALLBACK_URL=http://localhost:5173/verify-payment

# ----------------------------------------------------------------------- auth
# Cost factor for password hashing. Raise it as hardware gets faster.
BCRYPT_ROUNDS=12
RESET_TOKEN_TTL_MS=3600000

# -------------------------------------------------------------------- logging
LOG_LEVEL=info

# ------------------------------------------------ seeding the first admin
# Read only by `npm run seed:admin`, which prompts for anything left blank.
# SEED_ADMIN_USERNAME=
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_ROLE=owner
