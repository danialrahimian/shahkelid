# Copy to .env and fill in. Never commit the real .env.
# Everything here is read once, in src/config, and validated at boot: a missing
# required value in production stops the process instead of surfacing as
# `undefined` inside a request.

# ---------------------------------------------------------------- environment
NODE_ENV=development

# --------------------------------------------------------------------- server
HOST=localhost
PORT=5000
# Largest request body accepted.
BODY_LIMIT=100kb
# Where the browser app runs. CORS allows this origin and nothing else.
CLIENT_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------- database
DATABASE_HOST=127.0.0.1
DATABASE_NAME=shahkelid
# Set this instead of host/name to point at a replica set or Atlas.
# DATABASE_URI=mongodb://127.0.0.1:27017/shahkelid

# ----------------------------------------------------------------- postgresql
# The defaults match compose.yaml (`npm run services:up`), so these can stay
# commented out in development. Required in production.
# POSTGRES_URL=postgres://shah_kelid:dev-only-password@127.0.0.1:5432/shah_kelid
# POSTGRES_POOL_SIZE=10

# ---------------------------------------------------------------------- redis
# REDIS_URL=redis://127.0.0.1:6379/0

# ------------------------------------------------------------------- security
# Key for secrets stored in the database (two-factor secrets, panel
# credentials). Required in production; never reuse the development default.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# ------------------------------------------------------------------- accounts
# ACCOUNT_SESSION_NAME=sk.sid
# ACCOUNT_SESSION_MAX_AGE_MS=2592000000
# SIGN_IN_CODE_TTL_MS=600000
# SIGN_IN_CODES_PER_HOUR=5
# PASSWORD_LOCKOUT_MS=900000

# -------------------------------------------------------------------- session
# Required in production. Use a long random string, unique per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_NAME=shahkelid.sid
SESSION_MAX_AGE_MS=604800000

# --------------------------------------------------------------------- upload
UPLOAD_MAX_BYTES=5242880

# ----------------------------------------------------------------------- mail
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
# Required in production.
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@shahkelid.local

# -------------------------------------------------------------------- payment
# Required in production, where the app refuses to start without it.
# Left blank in development, the app uses a built-in stand-in gateway so the
# checkout flow can be walked end to end without real credentials.
ZARINPAL_MERCHANT_ID=
# "false" switches to the live gateway.
ZARINPAL_SANDBOX=true
PAYMENT_CALLBACK_URL=http://localhost:5173/verify-payment

# ----------------------------------------------------------------------- auth
# Cost factor for password hashing. Raise it as hardware gets faster.
BCRYPT_ROUNDS=12
RESET_TOKEN_TTL_MS=3600000

# -------------------------------------------------------------------- logging
LOG_LEVEL=info

# ------------------------------------------------ seeding the first admin
# Read only by `npm run seed:admin`, which prompts for anything left blank.
# SEED_ADMIN_USERNAME=
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_ROLE=owner

# ------------------------------------------------------------------ checkout
# Zarinpal: the sandbox needs no merchant id. For real payments set
# ZARINPAL_SANDBOX=false and your merchant id.
# ZARINPAL_SANDBOX=true
# ZARINPAL_MERCHANT_ID=
# ORDER_TTL_MS=3600000
# CARD_TRANSFER_TTL_MS=86400000

# -------------------------------------------------------------------- crypto
# USDT on TRON, straight to our wallet. Only the address: never the key.
# TRON_RECEIVE_ADDRESS=
# TRONGRID_URL=https://api.trongrid.io
# TRONGRID_API_KEY=
# TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# NOWPayments (from its dashboard; NOWPAYMENTS_SANDBOX=true for its sandbox)
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# NOWPAYMENTS_SANDBOX=false
# NOBITEX_URL=https://apiv2.nobitex.ir
# CRYPTO_RATE_MAX_AGE_MS=600000
# CRYPTO_INVOICE_TTL_MS=1800000

# -------------------------------------------------------------------- alerts
# Alerts to owners and admins go by email, and also to Telegram when these are
# set: a bot token from @BotFather, and the chat ids it should write to
# (comma-separated; a group's id starts with -100).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_IDS=

# ------------------------------------------------------------- provisioning
# The API's public address; customers' subscription links are built on it.
# Required in production.
# PUBLIC_API_URL=https://api.example.com
# FIRST_USE_DEADLINE_DAYS=30
# USAGE_SYNC_EVERY_MS=300000

# ---------------------------------------------------------- panel contract
# A PasarGuard panel that `npm run test:contract` may create and delete test
# users on (all named sk-contract-...). Not needed for anything else.
# PASARGUARD_TEST_URL=https://panel.example.com
# PASARGUARD_TEST_USERNAME=
# PASARGUARD_TEST_PASSWORD=
# PASARGUARD_TEST_GROUP_ID=1
# Nile testnet wallets for the USDT acceptance test (testnet only):
# TRON_TEST_RECEIVER_ADDRESS=
# TRON_TEST_SENDER_ADDRESS=
# TRON_TEST_SENDER_KEY=
