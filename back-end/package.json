{
  "name": "shah-kelid-api",
  "version": "1.0.0",
  "description": "Backend for the Shah Kelid store",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --require ./test/setup-env.cjs --import tsx --test --test-concurrency=1 \"test/**/*.test.js\" \"test/**/*.test.ts\"",
    "test:watch": "node --require ./test/setup-env.cjs --import tsx --test --watch \"test/**/*.test.js\" \"test/**/*.test.ts\"",
    "seed:admin": "node scripts/seed-admin.js",
    "audit": "npm audit --omit=dev",
    "seed:posts": "node scripts/seed-posts.js",
    "migrate:periods": "node scripts/normalize-product-periods.js",
    "seed:plans": "node scripts/seed-plans.js",
    "prune:products": "node scripts/prune-invalid-products.js",
    "prune:test-orders": "node scripts/prune-test-orders.js",
    "purge:generated": "node scripts/purge-generated-data.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/platform/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "worker": "tsx src/entrypoints/worker.ts",
    "dev:worker": "tsx watch src/entrypoints/worker.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.10",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "mongoose": "^9.2.1",
    "multer": "^2.2.0",
    "nodemailer": "^10.0.9",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zarinpal-checkout": "^1.1.1"
  },
  "devDependencies": {
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "mongodb-memory-server": "^11.2.0",
    "nock": "^14.0.17",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
