{
  "name": "shah-kelid-api",
  "version": "1.0.0",
  "description": "Backend for the Shah Kelid store",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx index.js",
    "dev": "tsx watch index.js",
    "test": "node --require ./test/setup-env.cjs --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:contract": "node --require ./test/setup-env.cjs --import tsx --test --test-concurrency=1 --require ./test/contract-env.cjs \"test/**/*.contract.test.ts\"",
    "test:watch": "node --require ./test/setup-env.cjs --import tsx --test --watch \"test/**/*.test.ts\"",
    "create-owner": "tsx scripts/create-owner.ts",
    "owner": "tsx scripts/owner.ts",
    "audit": "npm audit --omit=dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/platform/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "worker": "tsx src/entrypoints/worker.ts",
    "dev:worker": "tsx watch src/entrypoints/worker.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@shah-kelid/contracts": "^0.0.0",
    "bullmq": "^6.3.10",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "multer": "^2.2.0",
    "nodemailer": "^10.0.9",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tronweb": "^6.5.1",
    "typescript": "~5.9.3"
  }
}
